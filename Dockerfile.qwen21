# Derive from RunPod's already-published official CUDA 13 ComfyUI image.
# This deliberately does NOT rebuild Ubuntu, CUDA, PyTorch, or RunPod services.
FROM runpod/comfyui:1.3.0-comfyuiv0.30.0-cuda13.0

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG COMFYUI_VERSION=v0.38.0

# Replace only the baked ComfyUI application tree with v0.38.0 while retaining
# RunPod's preinstalled custom nodes, Manager cache, model-directory layout,
# bundle manifest metadata, start.sh, Python, CUDA, and utility services.
RUN set -eux; \
    test -d /opt/comfyui-baked; \
    test -f /opt/comfyui-baked/.runpod-bundle-version; \
    mkdir -p /tmp/comfyui-v038; \
    curl -fSL "https://github.com/comfyanonymous/ComfyUI/archive/refs/tags/${COMFYUI_VERSION}.tar.gz" \
      | tar -xz --strip-components=1 -C /tmp/comfyui-v038; \
    if [ -d /opt/comfyui-baked/custom_nodes ]; then \
      rm -rf /tmp/comfyui-v038/custom_nodes; \
      cp -a /opt/comfyui-baked/custom_nodes /tmp/comfyui-v038/custom_nodes; \
    fi; \
    if [ -d /opt/comfyui-baked/user ]; then \
      mkdir -p /tmp/comfyui-v038/user; \
      cp -an /opt/comfyui-baked/user/. /tmp/comfyui-v038/user/; \
    fi; \
    if [ -d /opt/comfyui-baked/models ]; then \
      mkdir -p /tmp/comfyui-v038/models; \
      cp -an /opt/comfyui-baked/models/. /tmp/comfyui-v038/models/; \
    fi; \
    cp /opt/comfyui-baked/.runpod-bundle-version /tmp/comfyui-v038/.runpod-bundle-version; \
    sed -i "s/^COMFYUI_VERSION=.*/COMFYUI_VERSION=${COMFYUI_VERSION}/" /tmp/comfyui-v038/.runpod-bundle-version; \
    cd /tmp/comfyui-v038; \
    git init; \
    git config user.name "RunPod Custom Image"; \
    git config user.email "runpod-custom-image@localhost"; \
    git add -A; \
    git commit -m "ComfyUI ${COMFYUI_VERSION} on official RunPod CUDA 13 image"; \
    git tag "${COMFYUI_VERSION}"; \
    git remote add origin https://github.com/comfyanonymous/ComfyUI.git; \
    rm -rf /opt/comfyui-baked; \
    mv /tmp/comfyui-v038 /opt/comfyui-baked; \
    rm -rf /tmp/comfyui-v038

# Install the v0.38.0 ComfyUI core requirements into the existing Python 3.12
# environment. The official image's constraints preserve its CUDA 13 PyTorch
# versions; the RunPod image's startup command and services remain unchanged.
RUN set -eux; \
    test -f /opt/comfyui-runtime-constraints.txt; \
    PIP_CONSTRAINT=/opt/comfyui-runtime-constraints.txt \
    PIP_INDEX_URL=https://pypi.org/simple \
    PIP_EXTRA_INDEX_URL=https://download.pytorch.org/whl/cu130 \
    python3.12 -m pip install --no-cache-dir \
      --constraint /opt/comfyui-runtime-constraints.txt \
      --index-url https://pypi.org/simple \
      --extra-index-url https://download.pytorch.org/whl/cu130 \
      -r /opt/comfyui-baked/requirements.txt

# Add --gpu-only to the launch argument array. This keeps the official /start.sh
# startup services intact and avoids depending on a mutable workspace args file.
RUN python3.12 - <<'PY'
from pathlib import Path

path = Path('/start.sh')
text = path.read_text()
needle = 'echo "Starting ComfyUI with args: ${COMFY_ARGS[*]}"'
if needle not in text:
    raise SystemExit('ERROR: expected official RunPod COMFY_ARGS launch marker not found; aborting build')
marker = '# Custom image: enforce GPU-only mode without duplicate arguments.\n'
if marker not in text:
    injection = (
        marker
        + 'if [[ ! " ${COMFY_ARGS[*]} " == *" --gpu-only "* ]]; then\n'
        + '    COMFY_ARGS+=(--gpu-only)\n'
        + 'fi\n\n'
    )
    text = text.replace(needle, injection + needle, 1)
    path.write_text(text)
    print('Patched /start.sh to always launch ComfyUI with --gpu-only')
else:
    print('/start.sh already contains the GPU-only patch')
PY

# Build-time smoke checks: confirm the baked version and launch argument patch.
RUN grep -q '^COMFYUI_VERSION=v0.38.0$' /opt/comfyui-baked/.runpod-bundle-version \
 && grep -q -- '--gpu-only' /start.sh \
 && python3.12 - <<'PY'
from importlib.metadata import version
print('ComfyUI baked version:', open('/opt/comfyui-baked/.runpod-bundle-version').readline().strip())
print('torch:', version('torch'))
print('torchvision:', version('torchvision'))
print('torchaudio:', version('torchaudio'))
PY
